{
    "DESIGN_NAME": "wishbone_ram",
    "VERILOG_FILES": ["dir::rtl/*.sv", "dir::rtl/*.v"],
    "CLOCK_PERIOD": 30,
    "CLOCK_PORT": "clk_i",
    "FP_PDN_SKIPTRIM": true,
    "RUN_POST_GRT_RESIZER_TIMING": true,
    "SYNTH_AUTONAME": true,

    "FP_SIZING": "absolute",
    "DIE_AREA": [0, 0, 1700, 1700],

    "VDD_NETS": [ "VPWR" ],
    "GND_NETS": [ "VGND" ],

    "PDN_MACRO_CONNECTIONS": [
        "ram0 VPWR VGND VPWR VGND",
        "ram1 VPWR VGND VPWR VGND"
    ],

    "MACROS": {
        "DFFRAM256x32": {
            "instances": {
                "ram0": {
                    "location": [100, 100],
                    "orientation": "FS"
                },
                "ram1": {
                    "location": [100, 800],
                    "orientation": "N"
                }
            },
            "gds": [
                "dir::macros/dffram256x32/layout/gds/DFFRAM256x32.gds.gz"
            ],
            "lef": [
                "dir::macros/dffram256x32/layout/lef/DFFRAM256x32.lef"
            ],
            "nl": [
                "dir::macros/dffram256x32/hdl/gl/DFFRAM256x32.v"
            ],
            "pnl": [
              "dir::macros/dffram256x32/hdl/gl/DFFRAM256x32.v"
            ],
            "spef": {
                "max*": [
                  "dir::macros/dffram256x32/timing/spef/DFFRAM256x32.max.spef"
                ],
                "min*": [
                  "dir::macros/dffram256x32/timing/spef/DFFRAM256x32.min.spef"
                ],
                "nom*": [
                  "dir::macros/dffram256x32/timing/spef/DFFRAM256x32.nom.spef"
                ]
            },
            "lib": {
		"max_ff*": "dir::macros/dffram256x32/timing/lib/max/DFFRAM256x32.Fastest.lib",
                "max_tt*": "dir::macros/dffram256x32/timing/lib/max/DFFRAM256x32.Typical.lib",
                "max_ss*": "dir::macros/dffram256x32/timing/lib/max/DFFRAM256x32.Slowest.lib",
                "min_ff*": "dir::macros/dffram256x32/timing/lib/min/DFFRAM256x32.Fastest.lib",
                "min_tt*": "dir::macros/dffram256x32/timing/lib/min/DFFRAM256x32.Typical.lib",
                "min_ss*": "dir::macros/dffram256x32/timing/lib/min/DFFRAM256x32.Slowest.lib",
                "nom_ff*": "dir::macros/dffram256x32/timing/lib/nom/DFFRAM256x32.Fastest.lib",
                "nom_tt*": "dir::macros/dffram256x32/timing/lib/nom/DFFRAM256x32.Typical.lib",
                "nom_ss*": "dir::macros/dffram256x32/timing/lib/nom/DFFRAM256x32.Slowest.lib"
            }
        }
    },

    "FP_PDN_VOFFSET": 5,
    "FP_PDN_HOFFSET": 5,
    "FP_PDN_VWIDTH": 3.1,
    "FP_PDN_HWIDTH": 3.1,
    "FP_PDN_VSPACING": 15.5,
    "FP_PDN_HSPACING": 15.5,
    "FP_PDN_VPITCH": 100,
    "FP_PDN_HPITCH": 100,

    "FP_PDN_CORE_RING": true,
    "FP_PDN_CORE_RING_VWIDTH": 3.1,
    "FP_PDN_CORE_RING_HWIDTH": 3.1,
    "FP_PDN_CORE_RING_VOFFSET": 12.45,
    "FP_PDN_CORE_RING_HOFFSET": 12.45,
    "FP_PDN_CORE_RING_VSPACING": 1.7,
    "FP_PDN_CORE_RING_HSPACING": 1.7,

    "PL_RESIZER_ALLOW_SETUP_VIOS": true,
    "GRT_RESIZER_ALLOW_SETUP_VIOS": true,
    "GRT_ANTENNA_ITERS": 15,
    "GRT_ANTENNA_MARGIN": 15,
    "RUN_HEURISTIC_DIODE_INSERTION": true,
    "DESIGN_REPAIR_MAX_WIRE_LENGTH": 800,
    "PL_WIRE_LENGTH_COEF": 0.05,
    "RUN_POST_GRT_DESIGN_REPAIR": true,
    "DESIGN_REPAIR_MAX_SLEW_PCT": 30,
    "DESIGN_REPAIR_MAX_CAP_PCT": 30,
    "MAX_TRANSITION_CONSTRAINT": 1.5
}
